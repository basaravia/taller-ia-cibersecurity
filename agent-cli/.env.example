# Proveedor de LLM activo: docker | foundry | groq
LLM_PROVIDER=docker

# --- Docker Model Runner (default, modelo local) ---
DOCKER_MODEL_BASE_URL=http://localhost:12434/v1
DOCKER_MODEL_NAME=ai/qwen3
DOCKER_MODEL_MAX_TOKENS=1200

# --- Azure AI Foundry ---
AZURE_AI_FOUNDRY_ENDPOINT=https://<tu-recurso>.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=<nombre-del-deployment>
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Memoria persistente: sqlite | postgres ---
MEMORY_BACKEND=sqlite
SQLITE_DB_PATH=./data/agent_memory.sqlite

# Postgres dedicado para memoria (ver README: crear base "agent_memory")
POSTGRES_URL=postgresql://admin:CHANGE_ME@localhost:5432/agent_memory

# --- MCP: servidor de busqueda web (repo langchain-mcp-duckduckgo, ejecutar aparte) ---
MCP_SEARCH_URL=http://localhost:8000/mcp

# --- agent_mesh: demo de malla de 4 agentes (ASI07 / ASI10) ---
# Opcional: modelo mas chico solo para la demo de malla (si LLM_PROVIDER=docker).
# OJO: tener 2 modelos locales cargados a la vez en Docker Model Runner (el
# principal + este) puede saturar memoria y devolver errores 502 intermitentes;
# probado con ai/smollm2-vllm:1.7B en este repo y fallo por eso. Si lo activas,
# valida que tu maquina soporte ambos modelos cargados simultaneamente.
# MESH_MODEL_NAME=ai/smollm2-vllm:1.7B
MESH_MODEL_MAX_TOKENS=1200
